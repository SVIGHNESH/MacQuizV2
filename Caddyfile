# MacQuiz v2 production reverse proxy (docs/09-deployment.md section 4).
#
# Caddy serves the React SPA and proxies the API + realtime gateway, both on
# one origin. That single origin is load-bearing, not a convenience: the auth
# cookies are SameSite=Lax/Strict (server/internal/authusers/http.go) and the
# server has no CORS middleware, so a browser on any other origin would never
# send them. web/src/api/client.ts encodes the same assumption with
# baseUrl: '/'. Splitting the SPA onto its own host (the Cloudflare Pages
# topology docs/09 section 3 sketches) breaks authentication outright.
#
# DOMAIN comes from .env.production, e.g. DOMAIN=quiz.example.edu.
#
# DOMAIN can also be a bare port - ":80" - which is a Caddy site address
# rather than a hostname: it serves plain HTTP on 80 for any Host and turns
# automatic HTTPS off. That is the no-domain-yet posture, and it requires
# MACQUIZ_ENV to be something other than "production", because production is
# the only thing that sets Secure on the auth cookies and a Secure cookie
# never survives a plain-HTTP origin. Both move together: real hostname and
# MACQUIZ_ENV=production, or ":80" and not.
{$DOMAIN} {
	encode zstd gzip

	# reverse_proxy upgrades WebSocket connections (Connection: Upgrade)
	# transparently; the /ws path needs no separate config.
	handle /api/* {
		reverse_proxy app:8080
	}
	# The wildcard is load-bearing: every gateway route lives at a subpath
	# (/ws/quizzes/{id}/monitor, /ws/attempts/{id}, /ws/users/{id}/notify)
	# and a bare /ws matcher is exact-match in Caddy, so it would send every
	# socket to the SPA fallback instead of the app.
	handle /ws/* {
		reverse_proxy app:8080
	}
	# Liveness for the uptime monitor (docs/10-operations.md section 2).
	# /readyz and /deploy-check stay unproxied - deploy.yml reaches
	# /deploy-check over the app's loopback-only host port instead.
	handle /healthz {
		reverse_proxy app:8080
	}

	# The SPA build, uploaded to /opt/macquiz/www by deploy.yml and mounted
	# read-only into this container. try_files sends unknown paths to
	# index.html so client-side routes survive a hard refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
